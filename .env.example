# Copy this file to .env and fill in your real Postgres credentials.
# .env should NEVER be committed to git (it's in .gitignore already).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=storagex
DB_USER=postgres
DB_PASSWORD=123456789

# Where uploaded files actually get stored on disk
STORAGE_ROOT=./storage-data

# Separate administrator account. These development defaults are overridden when
# you set values here. Store only a BCrypt hash, never a plaintext password.
ADMIN_USERNAME=essahzulu-hub
ADMIN_PASSWORD_HASH=$2b$12$KEP0kaiPm5NoLR6iycr4VeOqA1hl2hEej7bpWsKgMxNEvJasgAMsu
