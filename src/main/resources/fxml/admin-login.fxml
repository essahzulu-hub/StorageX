<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="14.0" styleClass="auth-page" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="com.essah.storagex.ui.AdminLoginController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>

    <Label styleClass="brand-avatar" text="S"/>
    <Label styleClass="app-title" text="StorageX Admin"/>
    <Label styleClass="subtitle" text="Administrator access only"/>

    <TextField fx:id="usernameField" maxWidth="280.0" promptText="Administrator username"/>
    <PasswordField fx:id="passwordField" maxWidth="280.0" promptText="Password"/>

    <Label fx:id="statusLabel" styleClass="status-label" text="" wrapText="true"/>

    <Button defaultButton="true" onAction="#handleAdminLogin" styleClass="primary-button" text="Admin Log In"/>
    <Button cancelButton="true" onAction="#handleBackToLogin" styleClass="secondary-button" text="Back to Log In"/>
</VBox>
