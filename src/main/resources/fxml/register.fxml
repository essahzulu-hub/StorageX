<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="14.0" styleClass="auth-page" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="com.essah.storagex.ui.RegisterController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>

    <Label styleClass="brand-avatar" text="S"/>
    <Label styleClass="app-title" text="Create your account"/>
    <Label styleClass="subtitle" text="Create a StorageX account"/>

    <TextField fx:id="usernameField" maxWidth="280.0" promptText="Username"/>
    <TextField fx:id="emailField" maxWidth="280.0" promptText="Email address"/>
    <PasswordField fx:id="passwordField" maxWidth="280.0" promptText="Password (at least 8 characters)"/>
    <PasswordField fx:id="confirmPasswordField" maxWidth="280.0" promptText="Confirm password"/>

    <Label fx:id="statusLabel" styleClass="status-label" text="" wrapText="true"/>

    <Button defaultButton="true" onAction="#handleRegister" styleClass="primary-button" text="Create Account"/>
    <Button cancelButton="true" onAction="#handleBackToLogin" styleClass="secondary-button" text="Back to Log In"/>
</VBox>
